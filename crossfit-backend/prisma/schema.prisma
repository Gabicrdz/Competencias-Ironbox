generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  athletes Athlete[]
  wods     Wod[]
}

model Athlete {
  id         Int      @id @default(autoincrement())
  fullName   String
  boxName    String?
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  scores     Score[]
}

model Wod {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  type        String   // Nuevo: "TIME" (For Time), "REPS" (AMRAP), "WEIGHT" (RM)
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  scores      Score[]
}

model Score {
  id           Int      @id @default(autoincrement())
  athleteId    Int
  wodId        Int
  resultValue  Int      // Nuevo: Valor numérico para que el sistema ordene (ej: 750 segundos o 120 reps)
  resultString String   // Nuevo: Texto para mostrar al público (ej: "12:30" o "120 reps")
  points       Int?     // Opcional: El sistema lo llenará solo
  position     Int?     // Opcional: El sistema lo llenará solo
  observations String?
  athlete      Athlete  @relation(fields: [athleteId], references: [id])
  wod          Wod      @relation(fields: [wodId], references: [id])
}